# Local setup (Linux or macOS or Windows with WSL2)
#
# 1. cp .env.local.example .env.local
# 2. Generate three URL safe passwords and paste each into BOTH the matching
#    *_PASSWORD var and DATABASE_*_URL below:
#        openssl rand -hex 32
# 3. Generate POSTGRES_PASSWORD the same way. It is the Postgres superuser,
#    which is exempt from row level security, so it needs its own value and
#    appears in no DATABASE_*_URL.
# 4. Generate BETTER_AUTH_SECRET: openssl rand -base64 32
# 5. bun run db:setup
# 6. bun run build
# 7. bun run start

POSTGRES_PASSWORD=replace-me
APP_USER_PASSWORD=replace-me
SERVICE_ROLE_PASSWORD=replace-me
AUTH_ROLE_PASSWORD=replace-me

DATABASE_URL=postgresql://app_user:replace-me@localhost:5432/piyaz
DATABASE_SERVICE_ROLE_URL=postgresql://service_role:replace-me@localhost:5432/piyaz
DATABASE_AUTH_URL=postgresql://auth_role:replace-me@localhost:5432/piyaz

BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# The request header your reverse proxy overwrites with the client address.
# Leave unset when nothing fronts the app.
#
# Rate limiting and the IP recorded on legal acceptance both identify a caller
# by address. Every proxy header is attacker-supplied unless something upstream
# overwrites it, so no header is read until you name one here, and until then
# every caller shares a single throttling bucket. Name only a header your proxy
# sets on inbound requests: nginx and Caddy overwrite x-forwarded-for or
# x-real-ip depending on configuration, and forward every other header
# untouched, so naming one they do not set leaves the address caller-chosen.
# TRUSTED_PROXY_HEADER=x-forwarded-for

# Your proxies' own addresses, comma separated, as IPs or CIDR ranges.
#
# Only needed when your proxy appends to an existing chain rather than
# replacing it (nginx's $proxy_add_x_forwarded_for does append). Listing them
# lets the client address be attributed past your own hops. Harmless to leave
# unset; the address then resolves to the last hop in the chain.
# TRUSTED_PROXIES=10.0.0.1
